FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-database-password
DB_NAME=hoffein_attorneys

# Railway also provides MYSQLHOST, MYSQLPORT, MYSQLUSER,
# MYSQLPASSWORD, and MYSQLDATABASE. The application accepts either naming scheme.

TEST_LAWYER_EMAIL=lawyer@hoffein.com
TEST_LAWYER_PASSWORD=replace-with-test-lawyer-password
TEST_CLIENT_EMAIL=client@hoffein.com
TEST_CLIENT_PASSWORD=replace-with-test-client-password

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
